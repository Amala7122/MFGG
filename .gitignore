# Godot cache / build output
.godot/
build/
export_templates/
*.log

# Godot engine binaries — never commit
# 单个 exe 超过 GitHub 的 100 MB 单文件上限，误提交会导致 push 被拒绝
Godot_v*.exe
Godot_v*.exe.sha256

# Iteration artifacts (screenshots, perf CSVs)
visual_captures/
performance_logs/
captures/
_artifacts/
__pycache__/
*.pyc
tools/_scratch/

# Local machine / tool configuration
active-game.json
opencode.json
parse_sweep_result.txt

# AI tool caches
.codebuddy/
.godot-mcp/

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 第三方音效库：Ovani Sound 授权要求不要把原始音频提交到公开仓库
# （FAQ 明确建议开源项目忽略音频目录；见 docs/issues.md 的 I-035）
addons/Sound FX Starter Pack Vol. 1/
