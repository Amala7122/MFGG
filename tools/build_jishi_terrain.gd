func _thermal_erosion(iterations: int) -> void:
	for _iteration in iterations:
		var next := heights.duplicate()
		for iz in N + 1:
			for ix in N + 1:
				var idx := iz * (N + 1) + ix
				var h := heights[idx]
				for oz in [-1, 0, 1]:
					for ox in [-1, 0, 1]:
						if ox == 0 and oz == 0:
							continue
						var nx: int = ix + int(ox)
						var nz: int = iz + int(oz)
						if nx < 0 or nx > N or nz < 0 or nz > N:
							continue
						var nidx: int = nz * (N + 1) + nx
						var diff := h - heights[nidx]
						if diff > 0.55:
							var move := minf((diff - 0.55) * 0.09, 0.07)
							next[idx] -= move
							next[nidx] += move
		heights = next


func _flow_erosion() -> void:
	var count := (N + 1) * (N + 1)
	var order: Array = []
	order.resize(count)
	for i in count:
		order[i] = i
	order.sort_custom(func(a, b): return heights[a] > heights[b])
	var receivers := PackedInt32Array()
	receivers.resize(count)
	receivers.fill(-1)
	for iz in N + 1:
		for ix in N + 1:
			var idx := iz * (N + 1) + ix
			var h := heights[idx]
			var best := -1
			var best_diff := 0.02
			for oz in [-1, 0, 1]:
				for ox in [-1, 0, 1]:
					if ox == 0 and oz == 0:
						continue
					var nx: int = ix + int(ox)
					var nz: int = iz + int(oz)
					if nx < 0 or nx > N or nz < 0 or nz > N:
						continue
					var nidx: int = nz * (N + 1) + nx
					var diff := h - heights[nidx]
					if diff > best_diff:
						best_diff = diff
						best = nidx
			receivers[idx] = best
	var flow := PackedFloat32Array()
	flow.resize(count)
	flow.fill(1.0)
	for idx in order:
		var receiver := receivers[idx]
		if receiver >= 0:
			flow[receiver] += flow[idx]
	var next := heights.duplicate()
	for idx in count:
		var receiver := receivers[idx]
		if receiver < 0:
			continue
		var drop := minf(2.2, sqrt(flow[idx]) * 0.03)
		next[idx] -= drop
		next[receiver] += drop * 0.35
	heights = next
	_thermal_erosion(1)


func _add_face(a: Vector3, b: Vector3, c: Vector3, verts: PackedVector3Array,
		normals: PackedVector3Array, colors: PackedColorArray, faces: PackedVector3Array) -> void:
	var normal := (b - a).cross(c - a)
	if normal.length_squared() < 0.000001:
		return
	normal = normal.normalized()
	var center := (a + b + c) / 3.0
	if normal.y < 0.0:
		normal = -normal
	var color := _terrain_color(center, normal)
	for point in [a, b, c]:
		verts.append(point)
		normals.append(normal)
		colors.append(color)
	faces.append(a)
	faces.append(b)
	faces.append(c)


func _terrain_color(center: Vector3, normal: Vector3) -> Color:
	var slope := 1.0 - clampf(normal.y, 0.0, 1.0)
	var path_distance := _path_distance(center.x, center.z)
	var tint := rng.randf_range(-0.015, 0.015)
	if not TERRAIN_ONLY and path_distance < 3.2:
		return Color(0.34, 0.28, 0.20) + Color(tint, tint, tint)
	if slope > 0.42:
		return Color(0.30, 0.29, 0.27) + Color(tint, tint, tint)
	if center.y < 4.0:
		return Color(0.13, 0.19, 0.10) + Color(tint, tint, tint)
	if center.y > 52.0:
		return Color(0.33, 0.32, 0.30) + Color(tint, tint, tint)
	if center.y > 32.0:
		return Color(0.27, 0.28, 0.19) + Color(tint, tint, tint)
	if center.y > 12.0:
		return Color(0.18, 0.25, 0.14) + Color(tint, tint, tint)
	return Color(0.16, 0.24, 0.13) + Color(tint, tint, tint)


func _height(x: float, z: float) -> float:
	return _apply_site(_base_height(x, z), x, z)


func _apply_site(h_in: float, x: float, z: float) -> float:
	var h := h_in
	for pad in pads:
		var mask := _pad_mask(pad, x, z)
		if mask > 0.0:
			var target: float = pad.h + pad.cross * (x - pad.cx) + pad.cross * 0.5 * (z - pad.cz)
			h = lerpf(h, target, mask)
	var path_h := _path_height(x, z)
	var path_mask := _path_mask(x, z)
	if path_mask > 0.0:
		h = lerpf(h, path_h, path_mask)
	var edge := smoothstep(140.0, 160.0, sqrt(x * x + z * z))
	h -= edge * 8.0
	return h


func _sample_height(x: float, z: float) -> float:
	var gx := clampf((x + HALF) / CELL, 0.0, float(N))
	var gz := clampf((z + HALF) / CELL, 0.0, float(N))
	var ix := mini(int(floor(gx)), N - 1)
	var iz := mini(int(floor(gz)), N - 1)
	var fx := gx - float(ix)
	var fz := gz - float(iz)
	var h00 := _h(ix, iz)
	var h10 := _h(ix + 1, iz)
	var h01 := _h(ix, iz + 1)
	var h11 := _h(ix + 1, iz + 1)
	return lerpf(lerpf(h00, h10, fx), lerpf(h01, h11, fx), fz)


func _base_height(x: float, z: float) -> float:
	# Terrain-only macro landform: asymmetric highland shelf, steep south edge,
	# deep valley to the south/west, high rock massif to the north/east.
	# No enclosing bowl: the valley exits southwest and stays open.
	var warp_x := warp_noise.get_noise_2d(x * 0.55, z * 0.55) * 18.0
	var warp_z := warp_noise.get_noise_2d(x * 0.55 + 90.0, z * 0.55 - 60.0) * 18.0
	var sx := x + warp_x
	var sz := z + warp_z
	# An open highland shelf: a steep south escarpment, a west valley edge,
	# and a single high rock massif to the east. No north/west enclosing rim.
	var shelf_z := 1.0 - smoothstep(32.0, 46.0, sz)
	var shelf_x := smoothstep(-78.0, -18.0, sx)
	var shelf := 30.0 * shelf_z * shelf_x
	var base := 2.0 + 1.2 * sin(x * 0.035 + z * 0.02)
	var east_high := 54.0 * smoothstep(44.0, 124.0, x) * (1.0 - smoothstep(42.0, 96.0, z))
	var h := maxf(base, shelf)
	h = maxf(h, east_high)
	var detail := height_noise.get_noise_2d(x + warp_x * 0.6, z + warp_z * 0.6) * 3.2
	var ridge := 1.0 - absf(ridge_noise.get_noise_2d(x * 0.62, z * 0.62))
	h += detail
	# Ridged rock only on the high massif and the shelf rim, not across the valley floor.
	var rock_band := smoothstep(26.0, 46.0, h)
	h += ridge * rock_band * 7.5
	# A ravine cuts the shelf slope; it is a drainage channel, not a crater rim.
	var gorge_x := -22.0 + (z - 28.0) * 0.38
	var gorge_width := 16.0 + (z - 28.0) * 0.12
	var gorge := 1.0 - smoothstep(0.0, gorge_width, absf(x - gorge_x))
	var gorge_along := smoothstep(26.0, 36.0, z) * (1.0 - smoothstep(105.0, 125.0, z))
	h -= gorge * 12.0 * gorge_along
	var valley := smoothstep(45.0, 70.0, z) * (1.0 - smoothstep(125.0, 150.0, z))
	h -= valley * (4.0 - 1.5 * smoothstep(-60.0, 40.0, x))
	# Minor gullies on the slope, not a uniform dome.
	if z > 48.0:
		var west_x := -46.0 + (z - 50.0) * 0.18
		var west_gully := 1.0 - smoothstep(3.0, 12.0, absf(x - west_x))
		h -= west_gully * 1.8 * smoothstep(50.0, 60.0, z) * (1.0 - smoothstep(90.0, 102.0, z))
	return h

func _hill(x: float, z: float, cx: float, cz: float, rx: float, rz: float,
		height: float, falloff: float) -> float:
	var d := sqrt(pow((x - cx) / rx, 2.0) + pow((z - cz) / rz, 2.0))
	if d <= 1.0:
		return height
	if d >= 1.0 + falloff:
		return 0.0
	return height * (1.0 - smoothstep(1.0, 1.0 + falloff, d))


func _pad_mask(pad: Dictionary, x: float, z: float) -> float:
	var dx := maxf(absf(x - pad.cx) - pad.hx, 0.0)
	var dz := maxf(absf(z - pad.cz) - pad.hz, 0.0)
	var d := sqrt(dx * dx + dz * dz)
	return 1.0 - smoothstep(0.0, pad.blend, d)


func _path_distance(x: float, z: float) -> float:
	var best := 99999.0
	for index in path_points.size() - 1:
		var a: Vector3 = path_points[index]
		var b: Vector3 = path_points[index + 1]
		var ab := Vector2(b.x - a.x, b.z - a.z)
		var ap := Vector2(x - a.x, z - a.z)
		var t := clampf(ap.dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
		var p := Vector2(a.x, a.z) + ab * t
		best = minf(best, p.distance_to(Vector2(x, z)))
	return best


func _path_height(x: float, z: float) -> float:
	var best := 99999.0
	var height := 0.0
	for index in path_points.size() - 1:
		var a: Vector3 = path_points[index]
		var b: Vector3 = path_points[index + 1]
		var ab := Vector2(b.x - a.x, b.z - a.z)
		var ap := Vector2(x - a.x, z - a.z)
		var t := clampf(ap.dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
		var p := Vector2(a.x, a.z) + ab * t
		var d := p.distance_to(Vector2(x, z))
		if d < best:
			best = d
			height = lerpf(a.y, b.y, t)
	return height


func _path_mask(x: float, z: float) -> float:
	var d := _path_distance(x, z)
	return 1.0 - smoothstep(3.0, 7.0, d)


func _h(ix: int, iz: int) -> float:
	return heights[iz * (N + 1) + ix]


func _fbm(x: float, z: float) -> float:
	var value := 0.0
	var amplitude := 1.0
	var frequency := 1.0
	for _octave in 3:
		value += sin(x * frequency + cos(z * frequency * 1.7)) * amplitude
		value += cos(z * frequency * 1.3 + sin(x * frequency * 0.8)) * amplitude
		amplitude *= 0.5
		frequency *= 2.0
	return value / 3.0


func _group(parent: Node, name: String) -> Node3D:
	var node := Node3D.new()
	node.name = name
	parent.add_child(node)
	node.owner = scene_root
	return node


func _static(parent: Node3D, name: String, position: Vector3, yaw := 0.0) -> StaticBody3D:
	var body := StaticBody3D.new()
	body.name = name
	body.position = position
	body.rotation.y = yaw
	parent.add_child(body)
	body.owner = scene_root
	return body


func _mesh_node(parent: Node, name: String, mesh: Mesh, material: Material,
		position := Vector3.ZERO, yaw := 0.0, cast_shadow := true) -> MeshInstance3D:
	var instance := MeshInstance3D.new()
	instance.name = name
	instance.mesh = mesh
	instance.material_override = material
	instance.position = position
	instance.rotation.y = yaw
	instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON if cast_shadow \
		else GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	parent.add_child(instance)
	instance.owner = scene_root
	return instance


func _add_box(builder: LowPoly.Builder, center: Vector3, size: Vector3, color: Color,
		bevel := 0.02) -> void:
	LowPoly.push_box(builder, center, size, color)


func _add_cyl(builder: LowPoly.Builder, center: Vector3, top_radius: float,
		bottom_radius: float, height: float, color: Color, segments := 8) -> void:
	var mesh := CylinderMesh.new()
	mesh.top_radius = top_radius
	mesh.bottom_radius = bottom_radius
	mesh.height = height
	mesh.radial_segments = segments
	_append_mesh(builder, mesh, center, color)


func _box_collision(body: Node3D, size: Vector3, center := Vector3.ZERO) -> void:
	var shape := BoxShape3D.new()
	shape.size = size
	var collision := CollisionShape3D.new()
	collision.shape = shape
	collision.position = center
	body.add_child(collision)
	collision.owner = scene_root


func _mass(parent: Node3D, name: String, center: Vector3, width: float, depth: float,
		wall_height: float, roof_height: float, wall_color: Color) -> void:
	var base_y := center.y
	var body := _static(parent, name, Vector3(center.x, 0, center.z))
	var walls := LowPoly.begin()
	_add_box(walls, Vector3(0, base_y + wall_height * 0.5, 0),
		Vector3(width, wall_height, depth), wall_color, 0.04)
	_add_box(walls, Vector3(0, base_y + wall_height * 0.32, depth * 0.5 + 0.02),
		Vector3(width * 0.16, wall_height * 0.62, 0.18), Color(0.06, 0.06, 0.06), 0.01)
	for index in 3:
		var wx := -width * 0.3 + index * width * 0.3
		_add_box(walls, Vector3(wx, base_y + wall_height * 0.66, depth * 0.5 + 0.02),
			Vector3(width * 0.1, wall_height * 0.16, 0.16), Color(0.05, 0.07, 0.09), 0.01)
	_mesh_node(body, "Walls", LowPoly.commit(walls), stone_material, Vector3.ZERO, 0.0, true)
	var roof := LowPoly.begin()
	_add_gable_roof(roof, base_y, width, depth, wall_height, roof_height)
	_mesh_node(body, "Roof", LowPoly.commit(roof), roof_material, Vector3.ZERO, 0.0, true)
	_box_collision(body, Vector3(width, wall_height, depth),
		Vector3(0, base_y + wall_height * 0.5, 0))

func _add_gable_roof(builder: LowPoly.Builder, base_y: float, width: float, depth: float,
		wall_height: float, roof_height: float) -> void:
	var x0 := -width * 0.5
	var x1 := width * 0.5
	var z0 := -depth * 0.5
	var z1 := depth * 0.5
	var eave := base_y + wall_height
	var ridge := eave + roof_height
	var a := Vector3(x0, eave, z0)
	var b := Vector3(x0, eave, z1)
	var c := Vector3(0, ridge, z1)
	var d := Vector3(0, ridge, z0)
	LowPoly.push_quad(builder, a, b, c, d, Color(0.14, 0.15, 0.17))
	var e := Vector3(x1, eave, z0)
	var f := Vector3(x1, eave, z1)
	LowPoly.push_quad(builder, d, c, f, e, Color(0.16, 0.17, 0.19))
	LowPoly.push_triangle(builder, a, d, e, Color(0.13, 0.14, 0.16))
	LowPoly.push_triangle(builder, b, f, c, Color(0.13, 0.14, 0.16))


func _tower(parent: Node3D, name: String, center: Vector3, size: float, height: float,
		roof_height: float) -> void:
	var base_y := center.y
	var body := _static(parent, name, Vector3(center.x, 0, center.z))
	var builder := LowPoly.begin()
	_add_box(builder, Vector3(0, base_y + height * 0.5, 0), Vector3(size, height, size),
		Color(0.34, 0.31, 0.26), 0.04)
	for index in 3:
		_add_box(builder, Vector3(-size * 0.25 + index * size * 0.25,
			base_y + height * 0.62, size * 0.5 + 0.02), Vector3(size * 0.1, height * 0.16, 0.14),
			Color(0.05, 0.07, 0.09), 0.01)
	var cone := LowPoly.faceted_cone(size * 0.78, roof_height, 4)
	_append_mesh(builder, cone, Vector3(0, base_y + height + roof_height * 0.5, 0),
		Color(0.14, 0.15, 0.17))
	_mesh_node(body, "Tower", LowPoly.commit(builder), stone_material, Vector3.ZERO, 0.0, true)
	_box_collision(body, Vector3(size, height, size),
		Vector3(0, base_y + height * 0.5, 0))


func _append_mesh(builder: LowPoly.Builder, mesh: Mesh, offset: Vector3, tint: Color) -> void:
	var arrays: Array
	if mesh is ArrayMesh:
		arrays = (mesh as ArrayMesh).surface_get_arrays(0)
	elif mesh is PrimitiveMesh:
		arrays = (mesh as PrimitiveMesh).get_mesh_arrays()
	else:
		return
	var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
	var index_value = arrays[Mesh.ARRAY_INDEX]
	var indices := PackedInt32Array()
	if index_value != null:
		indices = index_value as PackedInt32Array
	if indices.is_empty():
		for i in range(0, verts.size(), 3):
			LowPoly.push_triangle(builder, verts[i] + offset, verts[i + 1] + offset,
				verts[i + 2] + offset, tint)
	else:
		for i in range(0, indices.size(), 3):
			LowPoly.push_triangle(builder, verts[indices[i]] + offset,
				verts[indices[i + 1]] + offset, verts[indices[i + 2]] + offset, tint)


