func _save() -> void:
	var packed := PackedScene.new()
	var err := packed.pack(scene_root)
	if err != OK:
		push_error("闂傚倸鍊搁崐鎼佸磹閻戣姤鍤勯柛顐ｆ礀缁犵娀鏌熼崜褏甯涢柛濠呭煐閹便劌螣閹稿海銆愮紓浣哄С閸楁娊寮诲☉妯锋斀闁告洦鍋勬慨澶愭⒑缁嬫鍎愰柟鐟版搐閻ｇ柉銇愰幒婵囨櫇闂佺硶鍓濋敋闁诲繈鍎查妵鍕即濡搫濮﹂悗瑙勬礈閸犳牠銆佸Δ浣瑰闁惧繐澧ｉ妶鍡曠箚闁绘劦浜滈埀顒佺墵瀹曟繈骞嬮敃鈧壕鎸庣箾閹存瑥鐏╅柛妤佸▕閺屾洝绠涢妷褏锛熼梺?s" % err)
		quit(1)
		return
	var save_err := ResourceSaver.save(packed, SCENE_PATH)
	if save_err != OK:
		push_error("save failed: %s" % save_err)
		quit(1)
		return
	print("[JishiTerrain] saved: ", SCENE_PATH, " nodes: ", _count_nodes(scene_root))
	quit()


func _count_nodes(node: Node) -> int:
	var count := 1
	for child in node.get_children():
		count += _count_nodes(child)
	return count












