func _pave_pad(pad_name: String, tile: float, color_a: Color, color_b: Color) -> void:
	var pad: Dictionary = {}
	for candidate in pads:
		if String(candidate.name) == pad_name:
			pad = candidate
			break
	if pad.is_empty():
		return
	var body := _static(scene_root, "Paving_" + pad_name,
		Vector3(pad.cx, 0, pad.cz))
	var builder := LowPoly.begin()
	var x0: float = -pad.hx + 0.7
	var x1: float = pad.hx - 0.7
	var z0: float = -pad.hz + 0.7
	var z1: float = pad.hz - 0.7
	var nx := maxi(1, int(ceil((x1 - x0) / tile)))
	var nz := maxi(1, int(ceil((z1 - z0) / tile)))
	var sx := (x1 - x0) / float(nx)
	var sz := (z1 - z0) / float(nz)
	for ix in nx:
		for iz in nz:
			var x := x0 + (float(ix) + 0.5) * sx
			var z := z0 + (float(iz) + 0.5) * sz
			var y: float = pad.h + pad.cross * x + pad.cross * 0.5 * z
			var color := color_a if (ix + iz) % 2 == 0 else color_b
			_add_box(builder, Vector3(x, y + 0.03, z),
				Vector3(sx - 0.08, 0.05, sz - 0.08), color, 0.01)
	# A low stone curb around the terrace makes the pad read as a built platform.
	var curb := Color(0.30, 0.28, 0.24)
	_add_box(builder, Vector3(0, pad.h + 0.12, z0), Vector3(x1 - x0 + 0.2, 0.22, 0.18), curb, 0.02)
	_add_box(builder, Vector3(0, pad.h + 0.12, z1), Vector3(x1 - x0 + 0.2, 0.22, 0.18), curb, 0.02)
	_add_box(builder, Vector3(x0, pad.h + 0.12, 0), Vector3(0.18, 0.22, z1 - z0 + 0.2), curb, 0.02)
	_add_box(builder, Vector3(x1, pad.h + 0.12, 0), Vector3(0.18, 0.22, z1 - z0 + 0.2), curb, 0.02)
	_mesh_node(body, "Mesh", LowPoly.commit(builder), paving_material, Vector3.ZERO, 0.0, false)


