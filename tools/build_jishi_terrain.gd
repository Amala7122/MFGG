	_pave_pad("ChurchUpper", 1.6, Color(0.41, 0.38, 0.33), Color(0.35, 0.32, 0.28))
	_pave_pad("GateTerrace", 1.5, Color(0.38, 0.35, 0.30), Color(0.31, 0.28, 0.24))
	_pave_pad("EastService", 1.6, Color(0.34, 0.29, 0.22), Color(0.28, 0.24, 0.19))
	_pave_pad("VillageWest", 1.5, Color(0.35, 0.29, 0.20), Color(0.29, 0.24, 0.17))
	_pave_pad("VillageInn", 1.4, Color(0.35, 0.29, 0.20), Color(0.29, 0.24, 0.17))
