func _build_vegetation() -> void:
	var vegetation := _group(scene_root, "Vegetation")
	var placed := 0
	for _attempt in 240:
		if placed >= 34:
			break
		var x := rng.randf_range(-82.0, 82.0)
		var z := rng.randf_range(-78.0, 88.0)
		if _path_distance(x, z) < 6.0:
			continue
		if _on_pad(x, z):
			continue
		var y := _sample_height(x, z)
		if y < 1.0:
			continue
		var scale_value := rng.randf_range(0.8, 1.8)
		if absf(x) > 55.0 or z < -50.0:
			_pine(vegetation, "Pine_%02d" % placed, Vector3(x, y, z), scale_value)
		else:
			_cypress(vegetation, "Cypress_%02d" % placed, Vector3(x, y, z), scale_value)
		placed += 1
	placed = 0
	for _attempt in 140:
		if placed >= 20:
			break
		var x := rng.randf_range(-78.0, 78.0)
		var z := rng.randf_range(-70.0, 84.0)
		if _path_distance(x, z) < 4.0 or _on_pad(x, z):
			continue
		var y := _sample_height(x, z)
		var scale_value := rng.randf_range(0.5, 2.2)
		_rock(vegetation, "Rock_%02d" % placed, Vector3(x, y, z), scale_value)
		placed += 1


func _on_pad(x: float, z: float) -> bool:
	for pad in pads:
		if absf(x - pad.cx) <= pad.hx + 2.0 and absf(z - pad.cz) <= pad.hz + 2.0:
			return true
	return false


func _pine(parent: Node3D, name: String, position: Vector3, scale_value: float) -> void:
	var body := Node3D.new()
	body.name = name
	body.position = position
	body.scale = Vector3.ONE * scale_value
	parent.add_child(body)
	body.owner = scene_root
	var builder := LowPoly.begin()
	_add_cyl(builder, Vector3(0, 1.2, 0), 0.14, 0.24, 2.4, Color(0.20, 0.14, 0.09), 6)
	for tier in 3:
		var radius := 1.35 - tier * 0.3
		var height := 2.8 - tier * 0.3
		_append_faceted_cone(builder, Vector3(0, 2.2 + tier * 1.35, 0), radius, height,
			Color(0.08, 0.16, 0.09))
	_mesh_node(body, "Mesh", LowPoly.commit(builder), _mats_for_vegetation(), Vector3.ZERO, 0.0, true)


func _cypress(parent: Node3D, name: String, position: Vector3, scale_value: float) -> void:
	var body := Node3D.new()
	body.name = name
	body.position = position
	body.scale = Vector3.ONE * scale_value
	parent.add_child(body)
	body.owner = scene_root
	var builder := LowPoly.begin()
	_add_cyl(builder, Vector3(0, 1.2, 0), 0.1, 0.22, 2.4, Color(0.20, 0.14, 0.09), 6)
	for tier in 4:
		_append_faceted_cone(builder, Vector3(0, 2.0 + tier * 1.1, 0),
			0.9 - tier * 0.17, 2.9 - tier * 0.25, Color(0.06, 0.14, 0.08))
	_mesh_node(body, "Mesh", LowPoly.commit(builder), _mats_for_vegetation(), Vector3.ZERO, 0.0, true)


func _mats_for_vegetation() -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = Color(1.0, 1.0, 1.0)
	material.roughness = 1.0
	material.vertex_color_use_as_albedo = true
	material.vertex_color_is_srgb = true
	return material


func _append_faceted_cone(builder: LowPoly.Builder, center: Vector3, radius: float,
		height: float, color: Color) -> void:
	var cone := LowPoly.faceted_cone(radius, height, 8)
	_append_mesh(builder, cone, center, color)


