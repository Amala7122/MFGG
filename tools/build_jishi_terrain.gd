	paving_material = _material(Color(1.0, 1.0, 1.0), 0.9, 0.0, true)
	stone_material = _material(Color(0.36, 0.33, 0.28), 0.92, 0.0, false)
	stone_dark_material = _material(Color(0.24, 0.22, 0.19), 0.92, 0.0, false)
	roof_material = _material(Color(0.14, 0.15, 0.17), 0.8, 0.0, false)
	wood_material = _material(Color(0.22, 0.15, 0.09), 0.9, 0.0, false)
	gold_material = _material(Color(0.58, 0.45, 0.20), 0.35, 0.7, false)


func _material(base: Color, roughness: float, metallic: float, vertex_color: bool) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = base
	material.roughness = roughness
	material.metallic = metallic
	material.vertex_color_use_as_albedo = vertex_color
	material.vertex_color_is_srgb = true
	return material


