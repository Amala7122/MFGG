func _wall(parent: Node3D, name: String, start: Vector2, end: Vector2, base_y: float,
		height: float, thickness: float) -> void:
	var center := (start + end) * 0.5
	var length := start.distance_to(end)
	if length < 0.2:
		return
	var yaw := atan2(-(end.y - start.y), end.x - start.x)
	var body := _static(parent, name, Vector3(center.x, base_y, center.y), yaw)
	var builder := LowPoly.begin()
	_add_box(builder, Vector3(0, height * 0.5, 0), Vector3(length, height, thickness),
		Color(0.31, 0.29, 0.25), 0.04)
	_mesh_node(body, "Wall", LowPoly.commit(builder), stone_material, Vector3.ZERO, 0.0, true)
	_box_collision(body, Vector3(length, height, thickness), Vector3(0, height * 0.5, 0))


func _stairs(parent: Node3D, name: String, base: Vector3, yaw: float, width: float,
		depth: float, rise: float, steps: int) -> void:
	var body := _static(parent, name, base, yaw)
	for index in steps:
		var step_height := rise / float(steps)
		var step_depth := depth / float(steps)
		var mesh := LowPoly.begin()
		_add_box(mesh, Vector3(0, step_height * 0.5 + index * step_height,
			-depth * 0.5 + step_depth * 0.5 + index * step_depth),
			Vector3(width, step_height, step_depth), Color(0.32, 0.30, 0.26), 0.02)
		_mesh_node(body, "Step_%02d" % index, LowPoly.commit(mesh), stone_material,
			Vector3.ZERO, 0.0, true)
	_box_collision(body, Vector3(width, rise, depth), Vector3(0, rise * 0.5, 0))


