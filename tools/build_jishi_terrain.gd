	var sky_material := ProceduralSkyMaterial.new()
	sky_material.sky_top_color = Color(0.22, 0.31, 0.42)
	sky_material.sky_horizon_color = Color(0.66, 0.70, 0.74)
	sky_material.sky_curve = 0.18
	sky_material.sky_energy_multiplier = 0.95
	sky_material.ground_bottom_color = Color(0.08, 0.09, 0.10)
	sky_material.ground_horizon_color = Color(0.28, 0.29, 0.28)
	var sky := Sky.new()
	sky.sky_material = sky_material
	var environment := Environment.new()
	environment.background_mode = Environment.BG_SKY
	environment.sky = sky
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	environment.ambient_light_color = Color(0.62, 0.70, 0.80)
	environment.ambient_light_energy = 0.9
	environment.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	environment.tonemap_mode = Environment.TONE_MAPPER_ACES
	environment.tonemap_exposure = 1.05
	environment.fog_enabled = true
	environment.fog_mode = Environment.FOG_MODE_DEPTH
	environment.fog_light_color = Color(0.50, 0.56, 0.62)
	environment.fog_light_energy = 0.55
	environment.fog_depth_begin = 55.0
	environment.fog_depth_end = 480.0
	environment.fog_depth_curve = 1.3
	environment.ssao_enabled = true
	environment.ssao_intensity = 1.3
