static func owner(profile: String, key: String) -> String:
	for domain: String in FIELDS.get(profile, {}):
		if key in FIELDS[profile][domain]: return domain
	return ""

static func editable(profile: String, key: String, domain: String) -> bool:
	# 泰坦既有手雷入口暂由原型台兼容承载；明确标注玩家条件，未迁移数据。
	return owner(profile, key) == domain or (domain == "combat_prototype" and owner(profile, key) == "player_conditions")

static func title(profile: String, key: String) -> String:
	return TITLES.get(owner(profile, key), "未登记归属")

static func visual_editable(profile: String, form: String) -> bool:
	return profile.begins_with("Visual") and (form == "visual" or profile == "VisualChargeBeetle")

static func dependency(profile: String, key: String) -> String:
	if key == "body_size": return "体型同时影响碰撞、导航和技能世界尺寸；战斗样本需要重建"
	if key in ["shell_width", "shell_length", "shell_height"]: return "甲壳尺寸同时决定碰撞盒与导航；战斗样本需要重建"
	if key == "dash_distance": return "纯动作展示位移；真实冲锋距离在战斗原型测试台调整"
	if profile == "VisualBurstCrawler" and key in ["sac_size", "sac_lift", "sac_inflate", "throw_push", "body_size"]: return "会改变真实投囊发射点，需要在战斗原型测试台重测"
	if profile == "VisualPrismSpider" and key in ["eye_size", "eye_lift", "aim_lift", "body_height", "body_size"]: return "会改变真实狙击发射点，需要在战斗原型测试台重测"
	if key.begins_with("death_") or key in ["corpse_lifetime", "debris_lifetime"]: return "死亡表现／保留时长可能影响演出结束等待；需重播确认"
	if owner(profile, key) == "player_conditions": return "原有泰坦手雷条件兼容入口；归玩家条件，尚未迁移"
	if key.begins_with("crowd_"): return "当前为个体邻域响应，不是编组策略"
	return ""
