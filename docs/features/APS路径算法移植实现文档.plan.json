        ]
      },
      "blocked_by": ["P5"]
    },
    {
      "id": "P7",
      "title": "正式接入评估（需用户明确同意，不得自动开始）",
      "changes_behavior": true,
      "requires_user_approval": true,
      "write_scopes": ["godot-ruin_star_new/data/enemies/", "godot-ruin_star_new/data/navigation/"],
      "deliverable": "按敌人数据下发形状参数，量化战斗内帧率与观感，交用户试玩",
      "commands": [
        "python -B tools/run_acceptance.py --tests test_navigation_main_scene test_navigation_obstacles test_combat_spatial_policy test_combat_spatial_navigation test_combat_spatial_capabilities test_combat_spatial_attacks test_enemy_deployment test_sanctum_layout --task aps_port_p7 --timeout 600"
      ],
      "gate": {
        "evidence": ["reports/summary.md", "screenshots/*.png"],
        "assertions": [
          "8 项回归全部通过",
          "战斗内帧率与性能报告留档",
          "观感结论等待用户验收，不由自动结果代替"
