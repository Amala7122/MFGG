[gd_resource type="Resource" script_class="CombatSpatialProfile" load_steps=5 format=3]
[ext_resource type="Script" path="res://scripts/combat_spatial_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://scripts/traversal_capability.gd" id="2_capability"]
[sub_resource type="Resource" id="Walk"]
script = ExtResource("2_capability")
id = &"walk"
kind = 0
parameter_bindings = {"travel_speed": "move_speed"}
[sub_resource type="Resource" id="Jump"]
script = ExtResource("2_capability")
id = &"jump"
kind = 1
max_rise = 0.65
max_drop = 0.65
min_flight = 0.35
max_flight = 0.65
cooldown_channel = &"pounce"
parameter_bindings = {"travel_speed": "traversal_speed", "max_distance": "pounce_max_distance", "max_rise": "traversal_rise", "max_drop": "traversal_rise", "launch_speed_limit": "pounce_jump_speed", "gravity": "gravity", "cooldown": "attack_interval"}
[resource]
script = ExtResource("1_profile")
capabilities = Array[ExtResource("2_capability")]([SubResource("Walk"), SubResource("Jump")])
max_escape_wait = 3.0
