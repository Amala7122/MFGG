# Keep repository text files stable across Windows, macOS and Linux.
# Git normalizes text to LF and checks it out as LF for this project.
* text=auto eol=lf

# Binary assets must never receive line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.glb binary
*.fbx binary
*.blend binary
*.res binary
*.scn binary
